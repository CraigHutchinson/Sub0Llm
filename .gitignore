*.dylib
*.exe

# CUDA
*.ptx
*.cubin
*.fatbin

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Data and models (large files) — top-level only, not src/data or include/.../data
# Text corpora (*.txt, *.jsonl) up to ~10 MB are committed directly.
# Binary model weights use Git LFS (.gitattributes) and are excluded here.
/data/*.ckpt
/data/*.bin
/data/*.pt
/data/*.safetensors
/data/*.gguf
# Interleaved bench run artifacts (reproducible via tools/scripts/bench_vs_llama.ps1;
# headline numbers are recorded in commit messages + CLAUDE.md).
/data/bench_*.csv
/data/hybrid_vs_llama*.csv
# /models/ is an in-repo home for provenance-tagged checkpoints — its OWN models/.gitignore keeps the
# scaffolding (README/.gitattributes) tracked, ignores generated model dirs by default, and routes
# committed weights through Git LFS. (Do not blanket-ignore /models/ here, or the child rules never run.)
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# Python tooling
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Test artifacts
*.log
test_output/

# Claude Code session data
.claude/
