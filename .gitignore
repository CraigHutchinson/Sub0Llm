build/
out/
*.bin
*.log
*.o
*.so
*.dylib
/sub0llm
/build*
/models
/models_archive
# Claude Code's local session/tooling state (machine-specific paths, per-agent worktree permissions)
/.claude/

# Generated/large corpus artifacts (not source)
# *.words = cached corpus-scan state (configurator ScanState)
*.words
# *.model = per-corpus model-dims sidecar (auto-seeded by sub0-configure; force-add to pin a shared size)
*.model
data/fineweb_edu.txt
data/fineweb_edu.txt.done
# derived slices for smoke/throughput runs (recreated from the full corpus on demand)
data/fineweb_smoke.txt
data/cfg_test.txt
# fetched via scripts/get_tinystories.py, same category as the fineweb corpora above -- was an
# untracked-in-spirit 133-byte stub in git history that grew to a real multi-GB corpus without ever
# being added here
data/tinystories.txt
# fetched via scripts/get_gsm8k.py, same category as the corpora above
data/gsm8k.txt
runs/

# Model/training artifacts, wherever they land. /models is already ignored, but a mistyped model
# path drops these anywhere -- a positional-arg slip once wrote a 1.36 GB corpus.tok into data/ and
# it was very nearly committed. These names are only ever generated output, never sources, so
# ignoring them globally costs nothing and closes the whole class.
corpus.tok
tokenizer.tok
tokenizer.bin
tokenizer.stamp
meta.txt
train.log
*.ckpt
