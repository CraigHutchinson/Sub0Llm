# Build directories
build/
build-*/
out/
cmake-build-*/

# CMake generated
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.cmake
!cmake/CPM.cmake
!cmake/options.cmake
!cmake/deps.cmake
!cmake/compiler_flags.cmake
compile_commands.json

# Compiled output
*.o
