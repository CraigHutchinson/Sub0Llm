# Git LFS tracking patterns
# Large binary files — checkpoint weights, compiled artifacts
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text
*.pt   filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text

# Text corpora up to ~10 MB are committed directly.
# Larger datasets (>10 MB) should use LFS:
# data/*.jsonl filter=lfs diff=lfs merge=lfs -text
