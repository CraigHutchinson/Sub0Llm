+// Diagnostic only: float-activation scalar dots with official decoders.
+static void diagnostic_dot_Q2_K(int n,float* s,size_t bs,const void* x,size_t bx,const void* y,size_t by,int nrc) {
+ (void)bs;(void)bx;(void)by;GGML_ASSERT(nrc==1);
+ const struct ggml_type_traits* tt=ggml_get_type_traits(GGML_TYPE_Q2_K);
+ const int block=ggml_blck_size(GGML_TYPE_Q2_K);const size_t bytes=ggml_type_size(GGML_TYPE_Q2_K);
+ float tmp[256];float sum=0;const float* v=(const float*)y;
+ for(int i=0;i<n;i+=block){tt->to_float((const char*)x+(i/block)*bytes,tmp,block);for(int j=0;j<block;++j)sum+=tmp[j]*v[i+j];}*s=sum;
+}
